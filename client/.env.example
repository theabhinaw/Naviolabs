# Copy this file to ".env". Only variables that start with VITE_ are visible to the website.

# Address of your API. Leave empty in development (Vite forwards /api to http://localhost:5000).
# If the API lives on another domain in production, use e.g. https://api.yourdomain.com
VITE_API_URL=

# Optional safety net: if the API is offline, the form sends the lead straight to Google Sheets.
# Everyone can see this URL in the browser, so leave it empty if you prefer to keep it private.
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzJtXz38dKMoJe4f9VK2hCyLmNXugCk5O3J4qmEJR99pOBcL3EYWSSxxVVsQueQUH4/exec

VITE_CONTACT_EMAIL=theabhinawpatel6@gmail.com 

# WhatsApp number with country code, digits only (no + or spaces). Example: 919876543210
# The WhatsApp buttons stay hidden until you set this.
VITE_WHATSAPP_NUMBER= 918738825108
