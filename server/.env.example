# Copy this file to ".env" and fill in your own values. Never commit ".env".

# ---- Server ----
PORT=5000
NODE_ENV=development
# Website addresses allowed to call the API (comma separated). In production use your real domain.
CLIENT_ORIGIN=http://localhost:5173
# true = Express also serves the built React app from client/dist (one deployment for everything).
# Defaults to true when NODE_ENV=production.
SERVE_CLIENT=false
# Number of proxies in front of the server (Render, Railway, Heroku: 1). Leave empty on your own computer.
TRUST_PROXY=

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/navio-labs
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/navio-labs?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/navio-labs

# ---- Google Sheets lead webhook (Google Apps Script web app) ----
# Keep this URL private if your repository is public.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzJtXz38dKMoJe4f9VK2hCyLmNXugCk5O3J4qmEJR99pOBcL3EYWSSxxVVsQueQUH4/exec
WEBHOOK_TIMEOUT_MS=10000
